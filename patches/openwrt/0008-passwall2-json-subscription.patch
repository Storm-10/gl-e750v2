+		elseif type(xj) == "table" and type(xj[1]) == "table" and xj[1].outbounds then
+			-- Xray JSON config array (HAPP-style). Single-server configs first, then balancer ("auto") configs; duplicates skipped.
+			nodes = {}
+			local seen = {}
+			local function add(c, multi)
+				for _, o in ipairs(c.outbounds or {}) do
+					if o.protocol == "vless" and o.settings and o.settings.vnext then
+						local v, s = o.settings.vnext[1], o.streamSettings or {}
