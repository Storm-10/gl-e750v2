+							serviceName = g.serviceName, mode = g.multiMode and "multi" or nil }
+						local q = {}
+						for k, val in pairs(p) do
+							if val and val ~= "" then q[#q + 1] = k .. "=" .. UrlEncode(tostring(val)) end
+						end
+						local key = u.id .. "@" .. v.address .. ":" .. v.port
+						if not seen[key] then
+							seen[key] = true
+							local name = (c.remarks or "") .. (multi and (" " .. (o.tag or "")) or "")
+							nodes[#nodes + 1] = "vless://" .. key .. "?" .. table.concat(q, "&") .. "#" .. UrlEncode(name)
+						end
+					end
+				end
+			end
+			local function is_multi(c) return c.routing and c.routing.balancers and #c.routing.balancers > 0 end
+			for _, c in ipairs(xj) do if not is_multi(c) then add(c, false) end end
+			for _, c in ipairs(xj) do if is_multi(c) then add(c, true) end end
