+# Allow lowering xray CPU time down to 1%
+XRAY_CGROUP=/sys/fs/cgroup/xray
+
+xray_cgroup_add() {
+	[ -f /sys/fs/cgroup/cgroup.controllers ] || return 0
+	[ -d "$XRAY_CGROUP" ] || { 
+		echo "+cpu" > /sys/fs/cgroup/cgroup.subtree_control
+		mkdir "$XRAY_CGROUP"
+		echo 1 > "$XRAY_CGROUP/cpu.weight"
+	}
+	mkdir -p "$XRAY_CGROUP" 2>/dev/null || return 0
+	local pid
+	for pid in ${1:-$(pidof xray)}; do
+		log 1 "adding xray pid: $pid to $XRAY_CGROUP/cgroup.procs"
+		echo "$pid" > "$XRAY_CGROUP/cgroup.procs"
+	done
+}
+
