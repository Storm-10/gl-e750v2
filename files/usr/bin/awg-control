#!/bin/sh
# awg-control on_full|on_split|off: AmneziaWG full tunnel, split routes only, or back to split (ifdown if on_* brought it up)

interface="$(uci -q get awg-control.main.interface)"
vpn_zone="$(uci -q get awg-control.main.zone)"
lan_subnet="$(uci -q get awg-control.main.lan_subnet)"
lan_device="$(uci -q get awg-control.main.lan_device)"
route_table="$(uci -q get awg-control.main.route_table)"
rule_priority="$(uci -q get awg-control.main.rule_priority)"
list_dir=/etc/split-routes
batch_file=/tmp/awg-control.routes
state_file=/tmp/awg-control.state
switch_file=/tmp/awg-control.switch
ifup_file=/tmp/awg-control.ifup

[ -n "$interface" ] || interface=awg
[ -n "$vpn_zone" ] || vpn_zone=vpn
[ -n "$lan_subnet" ] || lan_subnet=192.168.201.0/24
[ -n "$lan_device" ] || lan_device=br-lan
[ -n "$route_table" ] || route_table=100
[ -n "$rule_priority" ] || rule_priority=10000

log_error() {
	logger -t awg-control -p user.err "$*"
	echo "awg-control: $*" >&2
}

validate_main_route() {
	if ip -4 route show table main default |
		grep -qE "(^|[[:space:]])dev[[:space:]]+$interface([[:space:]]|$)"; then
		log_error \
			"main default uses $interface; disable Route Allowed IPs for its default peer route"
		return 1
	fi
}

interface_is_up() {
	ubus call "network.interface.$interface" status 2>/dev/null |
		jsonfilter -q -e '@.up' | grep -qx true
}

ensure_firewall() {
	local vpn_zone_section

	vpn_zone_section="$(
		uci -q show firewall |
			sed -n "s/^firewall\\.\\([^.=]*\\)\\.name='$vpn_zone'$/\\1/p" |
			head -n 1
	)"

	if [ -z "$vpn_zone_section" ]; then
		vpn_zone_section="$vpn_zone"
		uci set "firewall.$vpn_zone_section=zone"
	fi

	uci set "firewall.$vpn_zone_section.name=$vpn_zone"
	uci set "firewall.$vpn_zone_section.input=REJECT"
	uci set "firewall.$vpn_zone_section.output=ACCEPT"
	uci set "firewall.$vpn_zone_section.forward=REJECT"
	uci set "firewall.$vpn_zone_section.network=$interface"
	uci set "firewall.$vpn_zone_section.masq=1"
	uci set "firewall.$vpn_zone_section.mtu_fix=1"

	uci -q get firewall.lan_wan >/dev/null ||
		uci set firewall.lan_wan=forwarding
	uci set firewall.lan_wan.src=lan
	uci set firewall.lan_wan.dest=wan
	uci -q delete firewall.lan_wan.enabled

	uci -q get firewall.lan_vpn >/dev/null ||
		uci set firewall.lan_vpn=forwarding
	uci set firewall.lan_vpn.src=lan
	uci set firewall.lan_vpn.dest="$vpn_zone"
	uci -q delete firewall.lan_vpn.enabled

	uci commit firewall
	service firewall reload
}

ensure_rule() {
	while ip -4 rule del priority "$rule_priority" 2>/dev/null; do :; done
	ip -4 rule add priority "$rule_priority" \
		iif "$lan_device" from "$lan_subnet" lookup "$route_table"
}

remove_policy() {
	while ip -4 rule del priority "$rule_priority" 2>/dev/null; do :; done
	ip -4 route flush table "$route_table" 2>/dev/null || true
}

load_lists() {
	echo "in load_lists"
	: >"$batch_file"

	for list in "$list_dir"/*.lst; do
		[ -f "$list" ] || continue
		awk -v dev="$interface" -v table="$route_table" '
			/^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
			$1 ~ /^[0-9.]+\/[0-9]+$/ {
				print "route replace " $1 " dev " dev " table " table
			}
		' "$list" >>"$batch_file"
	done
	
	echo "$batch_file:"
	cat "$batch_file"
	echo
	
	echo "route_table: $route_table"
	echo
	
	echo "running ip -4 route flush table $route_table"
	ip -4 route flush table "$route_table"
	echo
	
	echo "running ip -4 -batch $batch_file"
	ip -4 -batch "$batch_file" || {
		log_error "failed to load routes from $list_dir"
		return 1
	}

	ensure_rule || {
		log_error "failed to install rule for $lan_subnet"
		return 1
	}

	logger -t awg-control \
		"loaded $(wc -l <"$batch_file") routes into table $route_table"
}

apply_mode() {
	local switch_state
	local mode

	switch_state="$(cat "$switch_file" 2>/dev/null || echo off)"

	if ! interface_is_up; then
		remove_policy
		mode=wan
	elif [ "$switch_state" = on_full ]; then
		validate_main_route || return 1
		load_lists || return 1
		ip -4 route replace default dev "$interface" table "$route_table"
		mode=full
	else
		validate_main_route || return 1
		load_lists || return 1
		mode=split
	fi

	echo "$mode" >"$state_file"
	logger -t awg-control \
		"mode=$mode switch=$switch_state interface=$interface lan=$lan_subnet iif=$lan_device table=$route_table"
}

diag() {                          # log details after a failure: logread -e awg-control
	local s r n
	log_error "detail: switch=$(cat "$switch_file" 2>/dev/null) state=$(cat "$state_file" 2>/dev/null)" \
		"$interface up=$(interface_is_up && echo yes || echo no)"
	ip -4 route show table main default | while read -r r; do log_error "detail: main default: $r"; done
	for s in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)=amneziawg_$interface$/\1/p"); do
		r=$(uci -q get "network.$s.route_allowed_ips") || r=0
		log_error "detail: peer $s route_allowed_ips=$r allowed_ips=$(uci -q get "network.$s.allowed_ips")"
		[ "$r" = 1 ] && log_error "detail: fix: uci set network.$s.route_allowed_ips=0; uci commit network; ifup $interface"
	done
	n=$(date +%s)
	awg show "$interface" latest-handshakes 2>/dev/null | while read -r s r; do
		[ "$r" -gt 0 ] 2>/dev/null && r="$((n - r))s ago" || r=never
		log_error "detail: peer ${s%"${s#????????}"}... handshake $r"
	done
}

set_switch() {                    # on_*: ifup if down, full/split; off: split, ifdown if on_* brought it up
	local i=0
	echo "$1" >"$switch_file"
	if [ "$1" != off ] && ! interface_is_up; then
		touch "$ifup_file"; ifup "$interface"
		while ! interface_is_up && [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done
		interface_is_up || log_error "$interface not up within 30 s"
	fi
	if apply_mode && { [ "$1" = off ] || [ "$(cat "$state_file")" = "${1#on_}" ]; }; then
		[ "$1" != off ] || [ ! -f "$ifup_file" ] || { rm -f "$ifup_file"; ifdown "$interface"; }
		return 0
	fi
	diag                              # failed: back to off, undo own ifup
	echo off >"$switch_file"
	[ ! -f "$ifup_file" ] || { rm -f "$ifup_file"; ifdown "$interface"; }
	return 1
}

show_status() {
	echo "mode: $(cat "$state_file" 2>/dev/null || echo unknown)"
	echo "switch: $(cat "$switch_file" 2>/dev/null || echo off)"
	echo "interface: $interface"
	echo "LAN rule:"
	ip -4 rule show | grep "^$rule_priority:" || true
	echo "VPN table:"
	ip -4 route show table "$route_table"
	echo "main default:"
	ip -4 route show table main default
}

case "$1" in on_full|on_split|off|init|reload|sync|wan) exec 9>/var/lock/awg-control.lock; flock 9 ;; esac

case "$1" in
	init)
		[ -f "$switch_file" ] || echo off >"$switch_file"
		ensure_firewall || exit 1
		apply_mode
		;;
	reload|sync)
		apply_mode || { diag; exit 1; }
		;;
	on_full|on_split|off)
		set_switch "$1"
		;;
	is)                               # is on_full|on_split|off: current state matches (mcu-switch "already")
		s=$(cat "$state_file" 2>/dev/null)
		case "$2" in
			on_full)  [ "$s" = full ] ;;
			on_split) [ "$s" = split ] ;;
			off)      [ "$s" != full ] && [ ! -f "$ifup_file" ] ;;
			*)        exit 2 ;;
		esac
		;;
	wan)
		remove_policy
		echo wan >"$state_file"
		logger -t awg-control "mode=wan interface=$interface"
		;;
	status)
		show_status
		;;
	*)
		echo "usage: awg-control init|reload|sync|on_full|on_split|off|is|wan|status" >&2
		exit 2
		;;
esac
