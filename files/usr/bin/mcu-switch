#!/bin/sh
# mcu-switch — GL-E750 slide switch and power-button gestures, MCU screen modules. Events: logread -e mcu-switch
#   flip on|off [SEEN]   /etc/rc.button/BTN_0; flip and back within 'gesture' s = double flip
#   long                 mcu daemon, power button held 3 s (MCU 'Power_Saving_on/off')
#   metrics | standby [on|off] | sms [new] | <module> on|on_*|off     actions; module = 'module' section in /etc/config/mcu
# One screen mode at a time: a gesture or a new mode ends the current one; SMS and metrics modes take flips as input.
# Actions: luci-app-5gmodem "Buttons" (btn_BTN_0 pressed/released/double, btn_power pressed) if configured there,
# else /etc/config/mcu switch.cmd_on/cmd_off/cmd_double/cmd_long.
[ -n "$MCU_NICE" ] || ! nice -n -10 true 2>/dev/null || MCU_NICE=1 exec nice -n -10 "$0" "$@"   # keep pace under load
. /usr/share/mcu-switch/lib.sh
B5=/usr/share/5gmodem/buttons.sh

getcmd() {                                                                    # $1 on|off|double|long -> CMD, RUN; OFF=1: disabled
   local b=BTN_0 s=$1 e=1 d=
   case $1 in
      on) s=pressed e=0 ;; off) s=released e=0 ;;
      double) d="/usr/bin/mcu-switch sms" ;; long) b=power s=pressed d="/usr/bin/mcu-switch standby" ;;
   esac
   OFF=
   if [ -x $B5 ] && uci -q get 5gmodem.btn_$b >/dev/null; then              # defaults as LuCI "Buttons"
      RUN="$B5 run $b $s ${SEEN:-0}"; CMD=$(uci -q get 5gmodem.btn_$b.$s) || { CMD=$d; RUN='sh -c "$CMD"'; }
      [ "$b" = power ] || [ "$(uci -q get 5gmodem.btn_$b.en_$s || echo $e)" = 1 ] || { OFF=1 CMD=; }
   else config_get CMD switch "cmd_$1"; RUN='sh -c "$CMD"'; fi
}

title() {                                                                     # CMD -> R1: instant first line
   local n
   case "$CMD" in '') R1="No action set"; return ;; *mcu-switch\ *) ;; *) R1="Running..."; return ;; esac
   set -- ${CMD#*mcu-switch }                                                 # first call of a sequence
   case $1 in
      sms) R1="Loading SMS..." ;; metrics|meters) [ "$K" = m ] && R1="Stopping Metrics" || R1="Starting Metrics" ;; standby) R1="Standby mode" ;;
      *) config_get n "$1" name "$1"; case $2 in on*) n="$n starting" ;; *) n="$n stopping" ;; esac
         rj $((15 - ${#n})) 0s; R1="$n $R" ;;
   esac
}

act() {                                                                       # run action $1 for gesture
   getcmd "$1"
   [ -n "$CMD" ] || { log "$1: ${OFF:+disabled}${OFF:-no action set}"; clr; exit 0; }
   : > "$PID"; log "$1: $CMD"
   read -r _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ NI _ < /proc/$$/stat           # action runs at normal priority
   CMD=$CMD MCU_T0=$T0 MCU_K=$K MCU_G=$1 MCU_GEN=$$ MCU_NICE= nice -n $((-NI)) sh -c "$RUN" </dev/null >/dev/null 2>&1
   RC=$?; [ "$RC" = 0 ] || [ "$RC" = 143 ] || err "$1: exit $RC: $CMD"           # 143: superseded
}

tomode() { echo "$1" > "$IN"; kill -USR1 "$OP" 2>/dev/null; log "mode $OK: $1"; }       # input to SMS/metrics mode

flip() {                                                                      # $1 on|off, $2 SEEN
   local p k
   [ -c "$TTY" ] || { err "flip $1: $TTY is not a tty"; exit 1; }
   owner; p= k=; [ -f "$PEND" ] && read -r p k < "$PEND"
   if [ "${2:-0}" -lt "$GEST" ] && [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then    # flip back in time
      echo "g $k" > "$PEND"; log "flip $1 (SEEN ${2:-?}s): double flip"
      case $k in s|m) ;; *) getcmd double; [ -n "$OFF" ] || { title; send "$R1"; } ;; esac
      exit 0
   fi
   now; T0=$UPC DL=$UPC
   if [ "$OK" = s ] || [ "$OK" = m ]; then                                            # mode with input gets the flip at once
      echo "$$ $OK" > "$PEND"; log "flip $1 (SEEN ${2:-?}s)"; tomode flip
      tick "$GEST"; read -r p _ < "$PEND"; : > "$PEND"; [ "$p" = g ] || exit 0
      owner; [ "$OK" = s ] && { tomode double; exit 0; }
      K=$OK; own f; getcmd double; [ -n "$OFF" ] || { title; send "$R1"; }; act double; exit 0   # metrics: ends, action runs
   fi
   K=$OK; own f; echo "$$ $K" > "$PEND"
   getcmd "$1"; [ -n "$OFF" ] || { title; send "$R1"; }; log "flip $1 (SEEN ${2:-?}s)"
   tick "$GEST"; read -r p _ < "$PEND"; : > "$PEND"
   if [ "$p" = g ]; then act double; elif [ "$p" = $$ ]; then act "$1"; fi
}

metrics() {                                                 # toggle; screen 1: bandwidth, conns, load/CPU, mem; 2: signal (flip); MTO s
   [ -n "${MCU_K+x}" ] || { owner; MCU_K=$OK; }                            # CLI: toggle by current owner
   GOT= SC=1; trap 'GOT=1' USR1; own m
   [ "$MCU_K" = m ] && { log "metrics off"; send "Metrics off"; nap 2; clr; exit 0; }
   elapsed; END=$((UP + MTO)); log "metrics on for ${MTO}s"
   trap 'log "metrics off: superseded"; exit 0' TERM INT HUP
   sample; tick 1; sample
   while [ "$UP" -lt "$END" ]; do
      [ -n "$GOT" ] && { GOT=; A=; read -r A < "$IN"; : > "$IN"; [ "$A" = flip ] && SC=$((3 - SC)); DL=$UPC; log "metrics: screen $SC"; }
      if [ "$SC" = 1 ]; then scan; rows; bw "$RXM" "$TXM"; else signal; fi
      send "$R1" "$R2" "$R3" "$R4"; tick; sample
   done
   clr; log "metrics off: ${MTO}s timeout"
}

standby() {                                                                 # [on|off], default toggle; as mcu daemon power_saving_mode
   local w r
   case $1 in on) w=1 ;; off) w=0 ;; *) [ "$(uci -q get mcu.global.power_saveing)" = 1 ] && w=0 || w=1 ;; esac
   [ $w = 1 ] && r=ON || r=OFF
   own t; trap : TERM INT HUP; send "Standby mode $r"; log "standby $r"     # superseded: finish the switch-over
   for o in wireless.radio0.disabled wireless.radio1.disabled network.wan.disabled mcu.global.power_saveing; do uci set $o=$w; done
   uci commit wireless; uci commit network; uci commit mcu; sync; mcuref
   if [ $w = 1 ]; then ifdown wan; wifi down; else ifup wan; wifi up; fi
   nap 5; clr
}

case "$1" in
   flip)    case "$2" in on|off) flip "$2" "$3" ;; *) exit 2 ;; esac ;;
   long)    mcuref & owner; if [ "$OK" = s ]; then tomode long              # MCU shows its own "Standby mode": overwrite at once
            else now; T0=$UPC; K=$OK; own f; getcmd long; title; send "$R1"; log "long press"; act long; fi ;;
   metrics|meters) metrics ;;
   standby) standby "$2" ;;
   sms)     . /usr/share/mcu-switch/sms.sh ;;
   *)       if [ -n "$1" ] && [ "$(uci -q get "mcu.$1")" = module ]; then . /usr/share/mcu-switch/module.sh
            else echo "usage: $0 flip on|off [SEEN] | long | metrics | standby [on|off] | sms [new] | <module> on|on_*|off" >&2; exit 2; fi ;;
esac
