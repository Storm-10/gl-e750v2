#!/bin/sh
# GL-E750 slide switch -> mcu-switch (gestures, display). Backgrounded: procd runs button handlers one at a time,
# a 2nd flip within 'gesture' s must reach mcu-switch while the 1st still waits.
case "$ACTION" in pressed) s=on ;; released) s=off ;; *) exit 0 ;; esac
/usr/bin/mcu-switch flip "$s" "$SEEN" </dev/null >/dev/null 2>&1 &