config global 'global'
	option main_enabled '1'
	option wifi_2g_enabled '1'
	option wifi_5g_enabled '1'
	option lan_enabled '1'
	option vpn_enabled '1'
	option vpn_interface 'awg0'
	option custom_enabled '0'
	option content ''
	option wifi_password_enabled '1'
	option power_saveing '0'
	# standby_restore: set by mcu-switch while in standby - what it switched off and will switch back on

# mcu-switch: actions used when luci-app-5gmodem "Buttons" has no section for the button
config switch 'switch'
	option cmd_on ''
	option cmd_off ''
	option cmd_double '/usr/bin/mcu-switch meters'
	option cmd_long '/usr/bin/mcu-switch standby'
	option gesture '2'
	option refresh '2'
	option meters_timeout '600'
	option iface 'wwan0'

# mcu-switch <module> on|off: progress screen; done_re/log optional (else command exit)
config module 'pw'
	option name 'PW'
	option cmd_on "uci set passwall2.@global[0].enabled='1'; uci commit passwall2; /etc/init.d/passwall2 restart"
	option cmd_off "uci set passwall2.@global[0].enabled='0'; uci commit passwall2; /etc/init.d/passwall2 stop"
	option is_on '[ "$(uci -q get passwall2.@global[0].enabled)" = 1 ]'
	list log '/tmp/log/passwall2.log'
	list log '/tmp/etc/passwall2/acl/acl_default.log'
	option done_re 'Running complete'
	option done_re_off 'closing related programs and cache complete'
	option estimate '300'
	option grace '60'
	option stabilize '180'
	option cpu_ok '50'

config module 'awg'
	option name 'AWG'
	option cmd_on '/usr/bin/awg-control on'
	option cmd_off '/usr/bin/awg-control off'
	option is_on '[ "$(cat /tmp/awg-control.switch 2>/dev/null)" = on ]'
	option estimate '30'
	option grace '30'
	option stabilize '0'
