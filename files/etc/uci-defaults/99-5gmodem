#!/bin/sh

[ -f /etc/config/5gmodem ] || exit 0

uci -q batch <<'EOF'

set 5gmodem.@5gmodem[0].esim_apdu='uqmi'

set 5gmodem.sms.lednotify='1'
set 5gmodem.sms.smsled='mcu'
set 5gmodem.sms.ontopsms='1'
set 5gmodem.sms.mcu_sms='0'
set 5gmodem.sms.mcu_last='0'
set 5gmodem.sms.mcu_time='30'
set 5gmodem.sms.mcu_flip='page'
set 5gmodem.sms.mcu_double='read'
set 5gmodem.sms.mcu_long='exit'
set 5gmodem.sms.mirror_interval='30'
set 5gmodem.sms.newsms_hook='/usr/bin/mcu-switch sms new'

set 5gmodem.btn_power=button
set 5gmodem.btn_power.name='power'
set 5gmodem.btn_power.ct_pressed='conditional'
set 5gmodem.btn_power.pressed='/usr/bin/mcu-switch standby'

set 5gmodem.btn_BTN_0=button
set 5gmodem.btn_BTN_0.name='BTN_0'
set 5gmodem.btn_BTN_0.en_pressed='0'
set 5gmodem.btn_BTN_0.ct_pressed='simple'
set 5gmodem.btn_BTN_0.pressed='/usr/bin/mcu-switch awg on_full'
set 5gmodem.btn_BTN_0.en_released='0'
set 5gmodem.btn_BTN_0.ct_released='simple'
set 5gmodem.btn_BTN_0.released='/usr/bin/mcu-switch awg on_split'
set 5gmodem.btn_BTN_0.en_double='1'
set 5gmodem.btn_BTN_0.ct_double='simple'
set 5gmodem.btn_BTN_0.double='/usr/bin/mcu-switch sms'

commit 5gmodem
EOF

/etc/init.d/5gmodem-mm-inhibit stop
/etc/init.d/5gmodem-mm-inhibit disable

# wan is proto qmi (uqmi): ModemManager only competes for /dev/cdc-wdm0. 5gmodem starts it on demand (mmneed.sh).
[ "$(uci -q get network.wan.proto)" = modemmanager ] || [ ! -x /etc/init.d/modemmanager ] || {
	/etc/init.d/modemmanager stop
	/etc/init.d/modemmanager disable
}

exit 0
