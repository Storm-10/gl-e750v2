#!/bin/sh
# Set raw-ip mode on wwan0 when the interface appears.
# Required for Quectel EM060K-GL with qmi_wwan driver in raw-ip data format.

[ "$ACTION" = "add" ] || exit 0
[ "$INTERFACE" = "wwan0" ] || exit 0

[ -f "/sys/class/net/$INTERFACE/qmi/raw_ip" ] && echo Y > "/sys/class/net/$INTERFACE/qmi/raw_ip"
ip link set "$INTERFACE" up